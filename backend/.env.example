# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Neon database ──────────────────────────────────────
# Copy the pooled connection string from the Neon dashboard
# (Project → Connection Details → "Pooled connection").
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth (Better Auth) ────────────────────────────
# The backend only needs the auth server base URL to verify access-token JWTs
# against the public JWKS. No client/secret keys are used on the backend —
# login, sessions and cookies are handled by the frontend SDK.
# Find this in Neon Console → your project → Auth.
NEON_AUTH_BASE_URL=https://your-project.auth.neon.tech

# Optional: override the JWKS URL (defaults to NEON_AUTH_BASE_URL/.well-known/jwks.json)
# NEON_AUTH_JWKS_URL=https://your-project.auth.neon.tech/.well-known/jwks.json
# Optional: pin the expected token issuer for stricter verification
# NEON_AUTH_ISSUER=https://your-project.auth.neon.tech

# ── AI features (Anthropic / Claude) ───────────────────
# Optional. If unset, the AI endpoints return 503 and the rest of the API
# still runs. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model id (defaults to claude-opus-4-8 if unset)
ANTHROPIC_MODEL=claude-opus-4-8

# ── football-data.org (fixtures / standings / live) ────
# Free tier: register at https://www.football-data.org/client/register
# (10 requests/min, 12 top competitions). Without a key the scheduler stays idle.
FOOTBALL_DATA_API_KEY=
# Competition codes to track (football-data.org codes)
FOOTBALL_DATA_COMPETITIONS=PL,PD,SA,BL1,FL1,CL
# Background scheduler (hourly fixtures, per-minute live, daily digest)
SCHEDULER_ENABLED=true
# When to run the daily full refresh + cross-league digest (cron)
DAILY_DIGEST_CRON=0 6 * * *

# ── TheSportsDB (player photos) ────────────────────────
# football-data.org has no player imagery — its CDN only serves club crests,
# competition emblems and country flags — so photos come from TheSportsDB.
# "3" is their public test key and works out of the box; register at
# https://www.thesportsdb.com/ for your own before relying on it.
THESPORTSDB_API_KEY=3
# Players looked up per backfill tick. The job is resumable, so the table
# fills in over several runs rather than one large burst.
PLAYER_PHOTO_BATCH_SIZE=150
# When to run the photo backfill (cron). Photos rarely change, so this is slow
# by design; use `npm run sync:photos` for the initial fill.
PLAYER_PHOTO_CRON=30 4 * * *
